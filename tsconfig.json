{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom", "dom.iterable"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "scripts/*.ts", "site/app.ts"]
}
